    "test-milestones": "npm test && npm run validate && npm run full-data-demo && npm run spatial-demo && npm run advanced-demo && npm run batch-3.1-demo && npm run batch-3.5-demo && npm run batch-3.9-demo",
    "full-data-demo": "node scripts/full_data_demo.js",
    "spatial-demo": "node scripts/spatial_demo.js",
    "advanced-demo": "node scripts/advanced_demo.js",
    "batch-3.1-demo": "node scripts/batch_3_1_demo.js",
